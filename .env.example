# App Configuration
NODE_ENV=production
PORT=3005
BUILD_STANDALONE=1
LOG_LEVEL=info

# Database
# Transaction pooler (runtime queries)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms
# Session pooler (migrations, seed, check-schema, pg_dump)
DATABASE_URL_SESSION=postgresql://postgres:postgres@localhost:5432/lms

# Authentication
BETTER_AUTH_SECRET=super-secret-better-auth-key-at-least-32-chars-long!
BETTER_AUTH_URL=http://localhost:3005
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3005

# Storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=lms
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Email (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025

# Cron & Background Jobs
CRON_SECRET=super-secret-cron-token-at-least-16-chars-long!
